Output demo.gif
Set FontSize 18
Set Width 1000
Set Height 480
Set Padding 24
Set Theme "Dracula"
Set Framerate 24

Type "cd ~/Desktop/codeloom/demo-repo"
Enter
Sleep 300ms

Type "codeloom ."
Enter
Sleep 1s
Sleep 500ms

Type "codeloom --ask 'add retry logic' ."
Enter
Sleep 1s
Sleep 1s

Type "codeloom --get-symbol Engine ."
Enter
Sleep 1s
Sleep 500ms

Type "codeloom --rename retry retry_with_backoff ."
Enter
Sleep 1s
Sleep 500ms

Type "codeloom --files '*.py' ."
Enter
Sleep 1s
Sleep 500ms

Type "codeloom --index --engine c ."
Enter
Sleep 1s
Sleep 500ms

Type "codeloom --loom 'add retry logic' ."
Enter
Sleep 1s
Sleep 500ms
